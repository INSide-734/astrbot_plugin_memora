    "@tanstack/react-virtual": "^3.14.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.460.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
