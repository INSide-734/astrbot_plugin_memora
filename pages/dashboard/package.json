{
  "name": "memora-dashboard",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:artifacts": "python ../../scripts/check_dashboard_build_artifacts.py .",
    "smoke:runtime": "node scripts/runtime_smoke.mjs",
